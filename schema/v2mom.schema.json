{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/grokify/structured-goals/schema/v2mom.schema.json",
  "title": "V2MOM",
  "description": "V2MOM strategic planning document with optional OKR alignment",
  "type": "object",
  "required": ["vision", "values", "methods"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "vision": {
      "type": "string",
      "description": "The desired end state - what you want to achieve",
      "minLength": 1
    },
    "values": {
      "type": "array",
      "description": "Principles guiding decisions, ordered by priority",
      "items": {
        "$ref": "#/definitions/Value"
      },
      "minItems": 1
    },
    "methods": {
      "type": "array",
      "description": "Actions to achieve the vision (aligned with OKR Objectives)",
      "items": {
        "$ref": "#/definitions/Method"
      },
      "minItems": 1
    },
    "obstacles": {
      "type": "array",
      "description": "Global challenges to overcome (cross-cutting)",
      "items": {
        "$ref": "#/definitions/Obstacle"
      }
    },
    "measures": {
      "type": "array",
      "description": "Global success criteria (for flat V2MOM structure or north star metrics)",
      "items": {
        "$ref": "#/definitions/Measure"
      }
    },
    "projects": {
      "type": "array",
      "description": "Roadmap projects linked to methods",
      "items": {
        "$ref": "#/definitions/Project"
      }
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "description": "Document metadata and configuration",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this V2MOM"
        },
        "name": {
          "type": "string",
          "description": "Display name for this V2MOM"
        },
        "author": {
          "type": "string",
          "description": "Author name and title"
        },
        "team": {
          "type": "string",
          "description": "Team or organization"
        },
        "fiscalYear": {
          "type": "string",
          "pattern": "^FY[0-9]{4}$",
          "description": "Fiscal year (e.g., FY2025)"
        },
        "quarter": {
          "type": "string",
          "enum": ["Q1", "Q2", "Q3", "Q4", "H1", "H2", "Annual"],
          "description": "Planning period"
        },
        "version": {
          "type": "string",
          "description": "Document version"
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "In Review", "Approved", "Active", "Completed", "Archived"],
          "description": "Document status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (ISO 8601)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp (ISO 8601)"
        },
        "parentId": {
          "type": "string",
          "description": "ID of parent V2MOM for cascading alignment"
        },
        "structure": {
          "type": "string",
          "enum": ["flat", "nested", "hybrid"],
          "default": "hybrid",
          "description": "V2MOM organizational structure: flat (traditional), nested (OKR-aligned), or hybrid (both levels)"
        },
        "terminology": {
          "type": "string",
          "enum": ["v2mom", "okr", "hybrid"],
          "default": "v2mom",
          "description": "Display terminology: v2mom (Methods/Measures), okr (Objectives/Key Results), or hybrid"
        }
      }
    },
    "Value": {
      "type": "object",
      "description": "A guiding principle that supports the vision",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Value name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Value description"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Priority rank (1 = highest)"
        }
      }
    },
    "Method": {
      "type": "object",
      "description": "An action or objective to achieve the vision (OKR Objective equivalent)",
      "required": ["name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Method/Objective name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed description"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "Priority level (P0 = highest)"
        },
        "status": {
          "type": "string",
          "enum": ["Not Started", "Planning", "In Progress", "At Risk", "Completed", "Cancelled"],
          "description": "Current status"
        },
        "owner": {
          "type": "string",
          "description": "Responsible person or team"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Start date (ISO 8601)"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "End date (ISO 8601)"
        },
        "measures": {
          "type": "array",
          "description": "Key Results for this Method (OKR alignment, used in nested/hybrid mode)",
          "items": {
            "$ref": "#/definitions/Measure"
          }
        },
        "obstacles": {
          "type": "array",
          "description": "Obstacles specific to this Method (used in nested/hybrid mode)",
          "items": {
            "$ref": "#/definitions/Obstacle"
          }
        },
        "projects": {
          "type": "array",
          "description": "Project IDs linked to this Method",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Obstacle": {
      "type": "object",
      "description": "A challenge or risk that could prevent success",
      "required": ["name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Obstacle name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed description"
        },
        "severity": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"],
          "description": "Impact severity"
        },
        "likelihood": {
          "type": "string",
          "enum": ["Low", "Medium", "High"],
          "description": "Probability of occurrence"
        },
        "mitigation": {
          "type": "string",
          "description": "Mitigation strategy"
        },
        "status": {
          "type": "string",
          "enum": ["Identified", "Mitigating", "Resolved", "Accepted"],
          "description": "Current status"
        }
      }
    },
    "Measure": {
      "type": "object",
      "description": "A success metric or key result (OKR Key Result equivalent)",
      "required": ["name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Measure/Key Result name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed description"
        },
        "baseline": {
          "type": "string",
          "description": "Starting value"
        },
        "target": {
          "type": "string",
          "description": "Target value"
        },
        "current": {
          "type": "string",
          "description": "Current value"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Progress score (0.0-1.0, OKR scoring)"
        },
        "timeline": {
          "type": "string",
          "description": "Target timeline"
        },
        "status": {
          "type": "string",
          "enum": ["On Track", "At Risk", "Behind", "Achieved", "Missed"],
          "description": "Current status"
        }
      }
    },
    "Project": {
      "type": "object",
      "description": "A roadmap project linked to methods",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Project name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "category": {
          "type": "string",
          "description": "Project category"
        },
        "methodId": {
          "type": "string",
          "description": "Linked Method ID"
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "Priority level"
        },
        "status": {
          "type": "string",
          "enum": ["Proposed", "Approved", "In Progress", "Completed", "Cancelled"],
          "description": "Project status"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Start date (ISO 8601)"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "End date (ISO 8601)"
        },
        "quarter": {
          "type": "string",
          "description": "Target quarter"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of dependent projects"
        },
        "externalLinks": {
          "type": "object",
          "properties": {
            "jira": {
              "type": "string",
              "format": "uri"
            },
            "aha": {
              "type": "string",
              "format": "uri"
            },
            "productboard": {
              "type": "string",
              "format": "uri"
            },
            "confluence": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          },
          "description": "Links to external systems"
        }
      }
    }
  }
}
